# --- Agent model -------------------------------------------------------------
# anthropic | openrouter
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (Opus 5.5 defaults to medium)
AI_EFFORT=medium
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Data --------------------------------------------------------------------
# local    = embedded Postgres (PGlite) in ./.data, no setup needed
# supabase = hosted Postgres + Storage, shared by every instance and developer
DB_MODE=local
# Supabase -> Connect -> Transaction pooler (port 6543), with the database password filled in
DATABASE_URL=
# Supabase -> Project Settings -> API: project URL and the service_role / secret key (server-only)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket for case documents, created on first upload
SUPABASE_BUCKET=kelvin-documents
# Optional: STORAGE_MODE=local keeps documents on disk even with DB_MODE=supabase
# STORAGE_MODE=
# A shared database is seeded with `npm run seed`, not on first request.
# KELVIN_AUTOSEED=1 seeds it when empty (only safe with a single server).

# --- Demo --------------------------------------------------------------------
# live = call the model; replay = play /demo/recordings without network
AGENT_MODE=live
