# --- Agent model -------------------------------------------------------------
# anthropic | openrouter
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (Opus 5.5 defaults to medium)
AI_EFFORT=medium
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Data --------------------------------------------------------------------
# local = embedded Postgres (PGlite) in ./.data, no setup needed
# supabase = hosted Postgres + Storage
DB_MODE=local
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Demo --------------------------------------------------------------------
# live = call the model; replay = play /demo/recordings without network
AGENT_MODE=live
